# Copie para .env e ajuste os valores

# Banco (usado pelo container do Postgres)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fastzero_db

# Aplicação (para rodar fora do Docker; no compose o host é sobrescrito)
DATABASE_URL=postgresql+psycopg://app_user:troque-esta-senha@localhost:5432/fastzero_db
SECRET_KEY=gere-com-python-c-import-secrets-print-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
